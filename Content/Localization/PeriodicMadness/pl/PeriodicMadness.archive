		{
			"Namespace": "ST_PM_Schematics",
			"Children": [
				{
					"Source":
					{
						"Text": "Acidic Water Processing"
					},
					"Translation":
					{
						"Text": ""
					},
					"Key": "AcidicWaterProcessing/Name"
				},
				{
					"Source":
					{
						"Text": "Allows research of basic automation methods."
					},
					"Translation":
					{
						"Text": ""
					},
					"Key": "TransitionMetalSciencePack/Desc"
				},
				{
					"Source":
					{
						"Text": "An acidic fluid to dissolve the most basic of metals for further metallurgy."
					},
					"Translation":
					{
						"Text": ""
					},
					"Key": "AcidicWaterProcessing/Desc"
				},
				{
					"Source":
					{
						"Text": "Automation"
					},
					"Translation":
					{
						"Text": ""
					},
					"Key": "AutomationMk1/Name"
				},
				{
					"Source":
					{
						"Text": "By stacking Copper and Zinc disks ontop of one another, you can safely store power in a primitive battery."
					},
					"Translation":
					{
						"Text": "Układając miedziane i cynkowe dyski jeden na drugim, można „bezpiecznie” przechowywać energię w prymitywnej baterii."
					},
					"Key": "VoltaticPiles/Desc"
				},
				{
					"Source":
					{
						"Text": "Chlorine Processing"
					},
					"Translation":
					{
						"Text": "Przetwarzanie chloru"
					},
					"Key": "ChlorineProcessing/Name"
				},
				{
					"Source":
					{
						"Text": "Cleaner Power Generation"
					},
					"Translation":
					{
						"Text": "Produkcja czystej energii"
					},
					"Key": "CleanerPowerGeneration/Name"
				},
				{
					"Source":
					{
						"Text": "Ezekiel Ore Purifying"
					},
					"Translation":
					{
						"Text": "Oczyszczanie rudy metodą Ezechiela"
					},
					"Key": "EzekielOrePurifying/Name"
				},
				{
					"Source":
					{
						"Text": "Illumination for better visibility at night."
					},
					"Translation":
					{
						"Text": ""
					},
					"Key": "StreetLight/Desc"
				},
				{
					"Source":
					{
						"Text": "Key technology for automatic mass production."
					},
					"Translation":
					{
						"Text": ""
					},
					"Key": "AutomationMk1/Desc"
				},
				{
					"Source":
					{
						"Text": "The processing of Chlorine: make sure not to breath it in!"
					},
					"Translation":
					{
						"Text": "Przetwarzanie chloru: upewnij się, że go nie wdychasz!"
					},
					"Key": "ChlorineProcessing/Desc"
				},
				{
					"Source":
					{
						"Text": "Transition Metal Science Pack"
					},
					"Translation":
					{
						"Text": ""
					},
					"Key": "TransitionMetalSciencePack/Name"
				},
				{
					"Source":
					{
						"Text": "Using better techniques and filtering to squeeze more power out."
					},
					"Translation":
					{
						"Text": "Użycie lepszych technik i filtrowania w celu wyciśnięcia większej mocy."
					},
					"Key": "CleanerPowerGeneration/Desc"
				},
				{
					"Source":
					{
						"Text": "Using small doses of HCl, you can extract pure ore from ore chunks."
					},
					"Translation":
					{
						"Text": "Używając małych dawek HCl, można wydobyć czystą rudę z kawałków rudy."
					},
					"Key": "EzekielOrePurifying/Desc"
				},
