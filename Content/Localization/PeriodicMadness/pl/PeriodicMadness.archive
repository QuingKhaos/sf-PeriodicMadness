		{
			"Namespace": "ST_PM_Buildables",
			"Children": [
				{
					"Source":
					{
						"Text": "A building that uses plastic or resins to create molds and other products. Has a base production speed of 50 %."
					},
					"Translation":
					{
						"Text": "Budynek wykorzystujący plastik lub żywice do tworzenia form i innych produktów. Has a base production speed of 50 %."
					},
					"Key": "VacuumFormerMk1/Desc"
				},
				{
					"Source":
					{
						"Text": "A dirtier and more primitive version of a boiler, only takes seawater."
					},
					"Translation":
					{
						"Text": "Brudniejsza i bardziej prymitywna wersja kotła, pobiera tylko wodę morską."
					},
					"Key": "SeawaterBoiler/Desc"
				},
				{
					"Source":
					{
						"Text": "A smelting machine thats sole purpose is to produce alloys. They can only run on unique fuel. Has a base production speed of 200 %."
					},
					"Translation":
					{
						"Text": "Maszyna do wytapiania, której jedynym celem jest produkcja stopów. Może działać tylko na unikalnym paliwie. Has a base production speed of 200 %."
					},
					"Key": "Welder/Desc"
				},
				{
					"Source":
					{
						"Text": "Acid Plant"
					},
					"Translation":
