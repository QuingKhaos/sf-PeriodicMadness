				},
				{
					"Source":
					{
						"Text": "Adds the premium Gold Paint Finish to the Customizer, from where it can be applied to any building."
					},
					"Translation":
					{
						"Text": ""
					},
					"Key": "Caterium_PaintFinish/Desc"
				},
				{
					"Source":
