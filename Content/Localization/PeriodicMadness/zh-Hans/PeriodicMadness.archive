					},
					"Translation":
					{
						"Text": ""
					},
					"Key": "AutomationMk2/Name"
				},
				{
					"Source":
					{
						"Text": "Brass Processing"
					},
					"Translation":
					{
						"Text": "黄铜加工"
					},
					"Key": "BrassProcessing/Name"
				},
				{
					"Source":
					{
						"Text": "By stacking Copper and Zinc disks ontop of one another, you can safely store power in a primitive battery."
					},
					"Translation":
					{
						"Text": "将铜片和锌片叠放在一起，就可以“安全地”将电能储存在一个原始电池中。"
					},
					"Key": "VoltaticPiles/Desc"
				},
				{
					"Source":
					{
						"Text": "Byproduct Handling"
					},
					"Translation":
					{
						"Text": "副产物处理"
					},
					"Key": "ByproductHandling/Name"
				},
				{
