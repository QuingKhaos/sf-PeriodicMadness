					{
						"Text": ""
					},
					"Key": "Caterium_PaintFinish/Name"
				},
				{
					"Source":
					{
						"Text": "Illumination for better visibility at night."
					},
					"Translation":
					{
						"Text": ""
					},
					"Key": "StreetLight/Desc"
				},
				{
					"Source":
					{
						"Text": "Key technology for automatic mass production."
					},
					"Translation":
					{
						"Text": ""
					},
					"Key": "AutomationMk1/Desc"
				},
				{
					"Source":
					{
						"Text": "Means to clear and deal with byproducts from ore refining."
					},
					"Translation":
					{
						"Text": "清除和处理矿石提炼副产物的手段。"
