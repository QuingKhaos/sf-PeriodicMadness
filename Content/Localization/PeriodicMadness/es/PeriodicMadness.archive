		{
			"Namespace": "ST_PM_Buildables",
			"Children": [
				{
					"Source":
					{
						"Text": "A building that uses plastic or resins to create molds and other products. Has a base production speed of 50 %."
					},
					"Translation":
					{
						"Text": "Un edificio que utiliza plástico o resinas para crear moldes y otros productos. Has a base production speed of 50 %."
					},
					"Key": "VacuumFormerMk1/Desc"
				},
				{
					"Source":
					{
						"Text": "A dirtier and more primitive version of a boiler, only takes seawater."
					},
					"Translation":
					{
						"Text": "Una versión más sucia y primitiva de una caldera, sólo utiliza agua de mar."
					},
					"Key": "SeawaterBoiler/Desc"
				},
				{
					"Source":
					{
						"Text": "A smelting machine thats sole purpose is to produce alloys. They can only run on unique fuel. Has a base production speed of 200 %."
					},
					"Translation":
					{
						"Text": "Una máquina de fundición cuyo único propósito es producir aleaciones. Sólo puede funcionar con un único combustible. Has a base production speed of 200 %."
					},
					"Key": "Welder/Desc"
				},
