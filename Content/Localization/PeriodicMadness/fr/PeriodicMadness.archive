		{
			"Namespace": "ST_PM_Buildables",
			"Children": [
				{
					"Source":
					{
						"Text": "A building that uses plastic or resins to create molds and other products. Has a base production speed of 50 %."
					},
					"Translation":
					{
						"Text": "Un bâtiment pouvant créer des moules et autres objets à partir de plastique ou de résine. Has a base production speed of 50 %."
					},
					"Key": "VacuumFormerMk1/Desc"
				},
				{
					"Source":
					{
						"Text": "A dirtier and more primitive version of a boiler, only takes seawater."
					},
					"Translation":
					{
						"Text": "Une chaudière rudimentaire, et plus polluante. Elle fonctionne à l'eau de mer."
					},
					"Key": "SeawaterBoiler/Desc"
				},
				{
					"Source":
					{
						"Text": "A smelting machine thats sole purpose is to produce alloys. They can only run on unique fuel. Has a base production speed of 200 %."
					},
					"Translation":
					{
						"Text": "Un four qui ne produit que des alliages. Il nécessite son propre carburant spécial. Has a base production speed of 200 %."
					},
					"Key": "Welder/Desc"
				},
